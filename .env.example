# Gemini API キー(Google AI Studio で発行)
GEMINI_API_KEY=
# 予備のキー(メインのキーで上限・認証エラーが出たときに自動で切り替える)
GEMINI_API_KEY_SECONDARY=

# 開発中に使うモデル(未設定なら gemini-3.8-flash)。本番は gemini-4-hydrogen 固定
GEMINI_DEV_MODEL=

# 職員認証コード(合言葉)
ACCESS_CODE_LEVEL2=
ACCESS_CODE_O5=

# 認証Cookieの署名用シークレット(十分に長いランダム文字列)
SESSION_SECRET=

# 報告書の出どころ。gemini にしたときだけ Gemini で生成する。それ以外(空欄を含む)は、用意した見本の報告書を返す
REPORT_SOURCE=

# 財団データベース(全職員で共有する報告書)。Neon の接続文字列
# レート制限の回数もここに数える。未設定なら財団データベースは使えず、レート制限もかからない
DATABASE_URL=

# 財団データベースの添付画像を置く Vercel Blob(private のストア)の読み書きトークン
SCP_CAMERA_READ_WRITE_TOKEN=

# Gemini で生成する回数の、全体での1日の上限(未設定なら300)
GENERATE_DAILY_LIMIT=
